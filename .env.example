NODE_ENV=development
SERVICE_NAME=calorie-api
PORT=5000
LOG_LEVEL=debug
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

DATABASE_URL=postgresql://calorie:calorie@localhost:5433/calorie?schema=public
REDIS_URL=redis://localhost:6380

DEFAULT_DAILY_CALORIE_LIMIT=2100

# FoodData Central (https://fdc.nal.usda.gov/api-guide)
FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1
FDC_API_KEY=DEMO_KEY